# Local: cp frontend/.env.example frontend/.env.local
# Production: exact origin of the separately deployed Express backend.
# Redeploy the frontend after changing BACKEND_URL; Next.js builds rewrites.
BACKEND_URL=http://localhost:4000
# Default false: use real accounts through the /api reverse proxy.
NEXT_PUBLIC_DEMO_MODE=false
# Leave unset for same-origin sessions. Only needed for an advanced direct API connection.
# NEXT_PUBLIC_API_URL=
