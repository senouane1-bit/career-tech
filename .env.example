# Copy to backend/.env for local development.
DATABASE_URL=postgresql://careertech:careertech_local@localhost:5432/careertech
FRONTEND_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
COOKIE_CROSS_SITE=false
# OpenAI-compatible API. Keep credentials ONLY in server environment variables.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4.1-mini
# Local Ollama alternative: AI_BASE_URL=http://localhost:11434/v1,
# AI_API_KEY=ollama, AI_MODEL=qwen2.5:7b. Pull the model first.
